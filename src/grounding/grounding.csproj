<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>grounding</AssemblyName>
    <RootNamespace>Grounding</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- AOT on any publish: `dotnet publish -r <rid>` sets RuntimeIdentifier, and a
         RID-less `dotnet publish` (what dotnet-install runs) sets _IsPublishing, which
         lets PublishAot infer the RID. Plain build/run/pack stay framework-dependent
         and fast, with no AOT warnings. -->
    <PublishAot Condition="'$(RuntimeIdentifier)' != '' or '$(_IsPublishing)' == 'true'">true</PublishAot>
    <!-- System.CommandLine ships localized resources; they would make the AOT publish
         multi-file, which dotnet-install refuses. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantTimezone>true</InvariantTimezone>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <!-- `dotnet pack` produces a conventional (framework-dependent) global tool; the
       Native AOT binary is produced separately via `dotnet publish -r <rid>`. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>grounding</ToolCommandName>
    <PackageId>dotnet-package-grounding</PackageId>
    <Version>0.1.0</Version>
    <PackageOutputPath>$(MSBuildProjectDirectory)/nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <!-- Override transitive SQLitePCLRaw 2.1.x (GHSA-2m69-gcr7-jv3q) with the patched 3.0.3 line. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Markout" Version="[0.22.0]" />
  </ItemGroup>

  <!-- Statically link SQLite so Native AOT publishes a genuine single file. -->
  <Import Project="e_sqlite3-static.targets" />

</Project>
